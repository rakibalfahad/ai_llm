###############################################################################
# config/.env.example
# Copy this to config/.env and fill in the values.
# The setup/03_generate_secrets.sh script does this automatically.
#
# SECURITY: config/.env is in .gitignore — never commit it.
###############################################################################

# ── LLM Model ─────────────────────────────────────────────────────────────────
# Filename of the GGUF model inside the ./models/ directory
LLM_MODEL_FILE=Qwen2.5-Coder-7B-Instruct-Q4_K_M.gguf

# Context window in tokens per user slot.
# Reduce this when running multiple parallel users to fit KV cache in VRAM.
# 8192 is a good balance between context length and multi-user capacity.
LLM_CONTEXT_SIZE=8192

# GPU layers to offload (-1 = all = maximum GPU use)
LLM_GPU_LAYERS=-1

# Batch size for prompt processing (larger = faster, more VRAM)
LLM_BATCH_SIZE=512

# ── Multi-user concurrency ───────────────────────────────────────────────────
# How many users can generate responses simultaneously.
# Each slot consumes KV cache memory on the GPU.
#
# V100 16 GB budget with Qwen2.5-Coder-7B Q4_K_M (~4.4 GB model weights):
#   ~11 GB remains for KV cache.
#   At ctx=8192 (fp16): ~0.9 GB per slot → 4 slots = ~3.6 GB → total ~8 GB (safe)
#   At ctx=32768 (fp16): ~3.5 GB per slot → max 2-3 slots → set LLM_PARALLEL_REQUESTS=2
#
# Recommended settings:
#   1 user  → LLM_PARALLEL_REQUESTS=1, LLM_CONTEXT_SIZE=32768
#   2-3 users → LLM_PARALLEL_REQUESTS=3, LLM_CONTEXT_SIZE=8192
#   4+ users  → LLM_PARALLEL_REQUESTS=4, LLM_CONTEXT_SIZE=4096
LLM_PARALLEL_REQUESTS=3

# How long (seconds) a request may wait in the Redis queue before getting a
# 503 error. Increase for slower hardware or very long prompts.
# Set to 0 to reject immediately when all slots are busy (no queuing at all).
LLM_QUEUE_TIMEOUT=120

# ── Redis (distributed LLM slot queue) ──────────────────────────────────────────
# Redis acts as the shared token-bucket queue between all rag-api replicas.
# REDIS_URL is assembled automatically by docker-compose from REDIS_PASSWORD.
# You only need to set REDIS_PASSWORD here.
REDIS_PASSWORD=CHANGE_ME_run_03_generate_secrets
# REDIS_URL is set in docker-compose environment and does not need to be here.

# Default generation parameters (can be overridden per-request)
LLM_DEFAULT_MAX_TOKENS=2048
LLM_DEFAULT_TEMPERATURE=0.1

# ── Embedding Model (for RAG) ─────────────────────────────────────────────────
# HuggingFace sentence-transformers model name
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# 'cpu' to save VRAM for the LLM (recommended), or 'cuda' for faster embedding
EMBEDDING_DEVICE=cpu

# ── RAG Retrieval ─────────────────────────────────────────────────────────────
# How many document chunks to retrieve per query
RAG_TOP_K=5

# Minimum cosine similarity score to include a chunk (0.0–1.0)
RAG_SCORE_THRESHOLD=0.3

# ── Security (generated by setup/03_generate_secrets.sh) ─────────────────────
# API key required for all /v1/* requests to the RAG API
RAG_API_KEY=CHANGE_ME_run_03_generate_secrets

# ChromaDB auth token (internal — not exposed externally)
CHROMA_TOKEN=CHANGE_ME_run_03_generate_secrets

# Open WebUI secret key (for session signing)
WEBUI_SECRET_KEY=CHANGE_ME_run_03_generate_secrets

# ── Nginx ports ───────────────────────────────────────────────────────────────
# Change if ports 80/443 are already in use on the server
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ── Proxy (Intel internal network — remove if not needed) ─────────────────────
HTTP_PROXY=http://proxy-us.intel.com:912
HTTPS_PROXY=http://proxy-us.intel.com:912
NO_PROXY=localhost,127.0.0.1,chromadb,llm-server,rag-api,open-webui
